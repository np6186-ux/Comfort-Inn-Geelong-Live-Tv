<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required for streaming, weather, and clock -->
    <uses-permission android:name="android.intent.permission.INTERNET" />
    <uses-permission android:name="android.intent.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.intent.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android TV requirements: Touchscreen is NOT required -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.type.television"
        android:required="true" />

    <application
        android:name=".ComfortInnApp"
        android:allowBackup="true"
        android:icon="@drawable/comfort_inn_logo"
        android:label="@string/app_name"
        android:banner="@drawable/comfort_inn_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.ComfortInnGeelongTV"
        android:networkSecurityConfig="@xml/network_security_config"
        android:largeHeap="true"
        tools:targetApi="34">

        <!-- Main Launcher & Hospitality TV entry point -->
        <activity
            android:name=".MainActivity"
            android:banner="@drawable/comfort_inn_logo"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            
            <!-- Standard Android TV Leanback Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Device Home Launcher (for dedicated hospitality TV deployment) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Boot receiver to trigger background channel sync on TV boot -->
        <receiver
            android:name=".data.worker.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
